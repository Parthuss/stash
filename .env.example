# Transcription, carousel vision, and structured extraction.
# Free developer key: https://console.groq.com/keys
GROQ_API_KEY=

# Vision-capable model with JSON Object Mode.
STASH_EXTRACT_MODEL=qwen/qwen3.6-27b

# Which browser yt-dlp should lift Instagram cookies from.
# chrome | safari | firefox | brave | edge  (or leave blank to try anonymous)
STASH_COOKIES_FILE=
STASH_COOKIES_FROM_BROWSER=

# Phase 3 fallback when yt-dlp breaks: your own Cobalt instance.
# https://github.com/imputnet/cobalt
STASH_COBALT_URL=

# --- Durable capture: the Cloudflare Worker queue ---
# With these set, the phone can save from anywhere (cellular, other Wi-Fi, Mac
# asleep) and `stash daemon` drains the queue whenever the Mac is next awake.
# Leave blank to run fully local off the SQLite queue instead.
#   cd worker && npx wrangler login && npx wrangler deploy
STASH_WORKER_URL=
STASH_SECRET=

# --- Confirmation that a save actually finished ---
# imessage | ntfy | none.  The Shortcut's own notification only ever proves the
# request left the phone; this fires at the END of the pipeline, once a note
# exists. Whichever you pick, the other is tried as a fallback.
#
#   imessage — no app to install; sends you a normal iMessage. Needs a one-time
#              Automation grant (System Settings -> Privacy & Security ->
#              Automation -> your terminal -> Messages). Apple keeps tightening
#              Messages scripting, so verify with `stash notify` before trusting it.
#   ntfy     — free open-source iOS app, no permissions, verified working.
#              Public-server topics are UNAUTHENTICATED: the topic name is the
#              credential, so make it long and random, e.g.
#              python3 -c "import secrets;print('stash-'+secrets.token_hex(12))"
STASH_NOTIFY=none
STASH_NOTIFY_IMESSAGE_TO=
STASH_NTFY_TOPIC=
STASH_NTFY_SERVER=https://ntfy.sh
