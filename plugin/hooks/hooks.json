{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sf",
              "-m",
              "3",
              "-X",
              "POST",
              "-H",
              "Content-Type: application/json",
              "-H",
              "Authorization: Bearer ${user_config.key}",
              "--data-binary",
              "@-",
              "https://skwirl.app/v1/recall"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
