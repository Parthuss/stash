// Skwirl — share sheet capture, token-free.
//
// Template, not buildable as-is: {{WORKER_URL}} is substituted by shortcuts/build.sh
// from .env. It holds NO secret and asks NO questions on install: it hands the
// shared link to the web app in Safari (/?url=…), which is already signed in and
// saves it (app.js start()). If Safari isn't signed in, the link waits in
// sessionStorage through sign-in. Older installed copies that POST with a token
// keep working; /v1/ingest is unchanged.

#define name Skwirl
#define color violet
#define glyph archive
#define inputs url, text
#define from sharesheet
#define noinput stopwith "Share a link to Skwirl."

#include 'actions/web'

// Apps may share a title followed by a URL as text. Send only the first URL.
@urls = getURLs("{ShortcutInput}")
@urlCount = count(@urls)
if @urlCount == 0 {
    show("Share a link to Skwirl.")
    stop()
}
@firstURL = getFirstItem(@urls)
@link = urlEncode("{@firstURL}")
openURL("{{WORKER_URL}}/?url={@link}&src=shortcut")
